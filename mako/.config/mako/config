font=JetBrainsMono Nerd Font 15
background-color=#161616
progress-color=over #393939
text-color=#ffffff
border-size=3
max-visible=-1
outer-margin=16

on-button-middle=dismiss-all

icon-path=/usr/share/icons


[urgency=low]
border-color=#be95ff
[urgency=normal]
border-color=#42be65
[urgency=critical]
border-color=#ee5396


[app-name=multimedia-change]
layer=overlay
history=0
anchor=bottom-center
# Group all volume notifications together
group-by=app-name
# Hide the group-index
format=<b>%s</b>\n%b
text-alignment=center

[app-name=volume group-index=0]
# Only show last notification
invisible=0

